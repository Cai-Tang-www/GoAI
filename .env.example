MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=goai_db
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT_SECONDS=15
KAFKA_PORT=9092
KAFKA_JMX_PORT=9991
KAFKA_CLUSTER_ID=883565bc-3275-4fa8-bfe0-aa0b9ac72786
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
JWT_SECRET=your_jwt_secret_key
KAFKA_TOPIC=goai_topic
KAFKA_RUN_TOPIC=run_execute
KAFKA_RUN_GROUP_ID=run-worker-group
RBAC_ENABLE=true
RBAC_BOOTSTRAP_ADMIN_USERNAME=

# Legacy ModelScope compatibility (optional)
MODELSCOPE_KEY=
MODELSCOPE_MODEL=

# Provider v1 default
MODEL_PROVIDER_DEFAULT=deepseek

# DeepSeek profile
MODEL_DRIVER_DEEPSEEK=openai_compatible
MODEL_BASE_URL_DEEPSEEK=https://api.deepseek.com
MODEL_API_KEY_DEEPSEEK=
MODEL_NAME_DEFAULT_DEEPSEEK=deepseek-chat
MODEL_ENDPOINT_PATH_DEEPSEEK=/v1/chat/completions

# A2A outbound client
A2A_CLIENT_REQUEST_TIMEOUT_SECONDS=30
A2A_CLIENT_POLL_INTERVAL_MILLISECONDS=250

# Service governance
SERVICE_GOVERNANCE_ENABLE=true
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40
RATE_LIMIT_MAX_KEYS=10000
# Comma-separated: api,a2a,agui. Empty means all protected HTTP entrypoints.
RATE_LIMIT_SCOPES=api,a2a,agui
DOWNSTREAM_REQUEST_TIMEOUT_SECONDS=30
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_TIMEOUT_SECONDS=10